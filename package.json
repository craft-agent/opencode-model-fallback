{
  "name": "@craftsamo/opencode-model-fallback",
  "version": "0.0.0",
  "description": "Fall back between models in OpenCode when a primary agent or a subagent hits a limit.",
  "author": "craftsamo",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craft-agent/opencode-model-fallback.git"
  },
  "homepage": "https://github.com/craft-agent/opencode-model-fallback#readme",
  "bugs": "https://github.com/craft-agent/opencode-model-fallback/issues",
  "type": "module",
  "main": "dist/opencode.js",
  "exports": {
    ".": "./dist/opencode.js",
    "./opencode": "./dist/opencode.js",
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "default": "./dist/rpc.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.rpc.json",
    "typecheck:rpc": "tsc -p scripts/rpc-types-check",
    "smoke": "node scripts/smoke-opencode.mjs",
    "load:opencode": "node scripts/opencode-load.mjs",
    "test": "bun test --pass-with-no-tests --timeout 30000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "prepare": "node -e \"const fs=require('fs'),{execFileSync}=require('child_process');if(fs.existsSync('.git')){if(fs.existsSync('node_modules/husky'))execFileSync('husky',{stdio:'inherit'});if(fs.existsSync('node_modules/@craftsamo/repo-kit'))execFileSync('repo-kit',['agents','sync'],{stdio:'inherit'})}\""
  },
  "devDependencies": {
    "@craftsamo/repo-kit": "^1.4.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.3"
}

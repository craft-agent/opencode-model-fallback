{
  "name": "opencode-model-fallback",
  "version": "0.0.0",
  "description": "Fall back between models in OpenCode when a primary agent or a subagent hits a limit.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craftsamo"
  },
  "homepage": "https://github.com/craft-agent/opencode-model-fallback#readme",
  "repository": "https://github.com/craft-agent/opencode-model-fallback",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "opencode-model-fallback": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "OPENCODE_MODEL_FALLBACK_TOOLSETS",
        "OPENCODE_MODEL_FALLBACK_READ_ONLY",
        "OPENCODE_MODEL_FALLBACK_TOOLS",
        "OPENCODE_MODEL_FALLBACK_EXCLUDE_TOOLS",
        "OPENCODE_MODEL_FALLBACK_CONFIRM",
        "OPENCODE_MODEL_FALLBACK_UNATTENDED",
        "OPENCODE_MODEL_FALLBACK_GRANTS_DIR",
        "OPENCODE_MODEL_FALLBACK_GRANT_KEY"
      ]
    }
  }
}
